# Copy this file to .env and adjust the values for your environment.

# Signing key for session cookies. MUST be changed to a random value before
# any real/production use — sessions can be forged otherwise.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-please-0123456789

# Database.
# Docker/Postgres (default for `docker compose up`):
#   DATABASE_URL=postgresql+psycopg2://dispohub:dispohub@db:5432/dispohub
# Local without Docker (SQLite file):
DATABASE_URL=sqlite:///./dispohub.db

# Load demo data on first start if the database is empty (recommended for
# trying the app out; set to false for a real deployment with real data).
SEED_ON_STARTUP=true

# Only send the session cookie over HTTPS. Set to true once you are running
# behind HTTPS in production; keep false for local HTTP development,
# otherwise login will not work.
SESSION_COOKIE_SECURE=false

# Optional: real invoice inbox mailbox (see app/services/mail_ingest.py).
# Without these three values, invoice intake stays in simulated demo mode.
# Use a dedicated mailbox, never a personal/admin inbox — this account needs
# full read access to whatever mailbox you configure here.
# IMAP_HOST=imap.yourcompany.example
# IMAP_USER=invoices@yourcompany.example
# IMAP_PASSWORD=app-password-here
# IMAP_ORDNER=INBOX
